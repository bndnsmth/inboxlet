{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "inboxlet-site",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "inboxlet.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
  },
}
