{
  "name": "inboxlet",
  "version": "0.1.0",
  "description": "Ephemeral email inboxes for agents and automation, built on Cloudflare.",
  "keywords": [
    "agents",
    "cli",
    "cloudflare",
    "disposable-email",
    "durable-objects",
    "email",
    "mcp"
  ],
  "homepage": "https://inboxlet.dev",
  "bugs": {
    "url": "https://github.com/bndnsmth/inboxlet/issues"
  },
  "license": "MIT",
  "author": "Brandon Smith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndnsmth/inboxlet.git"
  },
  "bin": {
    "inboxlet": "dist/inboxlet.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "docs",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "site/public/avatar.png"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "deploy": "npm run worker:deploy",
    "site:build": "vp -C site build",
    "site:deploy": "npm run site:build && wrangler deploy --config site/wrangler.jsonc",
    "site:dev": "vp -C site dev",
    "test": "vp test run",
    "test:e2e": "tsx test/e2e.ts",
    "package:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "worker:dev": "wrangler dev --experimental-new-config --env-file .dev.vars",
    "worker:deploy": "wrangler deploy --experimental-new-config --env-file .deploy.vars --secrets-file .deploy.secrets"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.0.0",
    "agents": "^0.21.0",
    "html-to-text": "^10.0.1",
    "postal-mime": "^2.7.5",
    "tsx": "^4.23.0",
    "vite-plus": "0.2.9",
    "wrangler": "^4.123.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.16.0"
}
